# Pickle Ultra Browser — config.env
# Every value below is optional; the code has a working default for each one.
# Copy this file to config.env and uncomment only what you need.
#
# Chromium binary. When unset, the resolver tries CHROME_BIN, the Playwright cache
# (PLAYWRIGHT_BROWSERS_PATH, $HOME/.cache/ms-playwright, <tree's parent>/.cache/ms-playwright)
# and finally PATH.
# PICKLE_ULTRA_CHROME=/usr/bin/chromium

# Time budget for the body to settle after a navigation (ms).
# PU_SETTLE_MS=4000

# 0 shows a window (needs an X server); 1 is headless.
# PICKLE_ULTRA_HEADLESS=1

# Stop the daemon and browser after this many idle seconds.
# IDLE_STOP_SEC=600

# Entry points that always need a session: chain.sh skips the lanes and returns
# next=builtin-browser-vault instead of trying. Comma separated, host or host/path.
# Leave empty to rely on the page signals alone.
# AUTH_SKIP_HOSTS=shop.example.com/login,shop.example.com/checkout
